# Production defaults for a public/static deploy of this fork (Vercel etc.).
# Vite loads this on top of .env in production mode; only a handful of keys
# are overridable from process.env (see vite.config.mts), so deploy-critical
# values must live in a committed env file.

# Privy MUST be blank on a public deploy: the placeholder ids in .env are
# truthy, so the Privy provider initializes with an invalid app id and
# crashes the entire React root.
PRIVY_APP_ID=""
PRIVY_CLIENT_ID=""

# The config reads WALLETCONNECT_PROJECT_ID; .env still carries the old
# WALLET_CONNECT_PROJECT_ID spelling. Placeholder keeps the app booting —
# replace with a real project id to enable WalletConnect.
WALLETCONNECT_PROJECT_ID="walletconnect_project_id"

# Yeetful chat embed origin — empty = https://www.yeetful.com (production).
YEETFUL_EMBED_ORIGIN=""
